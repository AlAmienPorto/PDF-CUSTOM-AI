generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ActivityLog {
  id        String   @id @default(cuid())
  toolId    String
  fileName  String
  fileSize  Int      // in bytes
  status    String   // "SUCCESS" or "FAILED"
  createdAt DateTime @default(now())
}
